# Append these values to automation/.env. Do not commit real credentials.
# Keep the R2 bucket private and scope the API token to this bucket only.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/BUCKET_NAME
RESTIC_PASSWORD=replace-with-a-separate-long-random-recovery-secret
AWS_ACCESS_KEY_ID=replace-with-the-r2-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-the-r2-secret-access-key
AWS_DEFAULT_REGION=auto

# Must be an absolute path on the Docker host. Keep it outside the repository.
BACKUP_DIR=/var/backups/content-ops

# Stable identity written into every backup. Keep this value unchanged when
# moving the same project to a disaster-recovery host.
BACKUP_PROJECT_ID=content-ops

# Backup and confirmed restore share this exclusive maintenance lock. The
# watchdog reads the marker so planned downtime does not create false alerts.
MAINTENANCE_LOCK_DIR=/var/backups/content-ops/.maintenance.lock
MAINTENANCE_MARKER_FILE=/var/backups/content-ops/maintenance.state

# Full encrypted repository read after every backup. Lower values reduce I/O but
# no longer provide the same end-to-end validation guarantee.
RESTIC_CHECK_SUBSET=100%

# Grace period used while stopping n8n and codex-worker for backup/restore.
OPS_STOP_TIMEOUT_SECONDS=60

# Optional pinned helper images used to read and restore named volumes.
BACKUP_HELPER_IMAGE=alpine:3.20
BACKUP_POSTGRES_IMAGE=postgres:16-alpine

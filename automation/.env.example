POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace-with-a-long-random-secret

N8N_VERSION=2.30.8
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret
N8N_HOST=automation.example.com
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://automation.example.com/
N8N_PROXY_HOPS=1
GENERIC_TIMEZONE=Europe/Istanbul

TELEGRAM_ALLOWED_USER_ID=123456789
TELEGRAM_ALLOWED_CHAT_ID=123456789
# External watchdog uses the same bot through Telegram's HTTPS API.
TELEGRAM_BOT_TOKEN=replace-with-the-botfather-token
TELEGRAM_ALERT_CHAT_ID=123456789
CONTENT_PROFILE_DIR=/app/templates
WATCHDOG_STATE_DIR=/var/lib/content-ops
WATCHDOG_DEDUPE_SECONDS=21600
WATCHDOG_MAINTENANCE_MAX_SECONDS=7200
WORKER_API_TOKEN=replace-with-a-long-random-secret
N8N_CALLBACK_TOKEN=replace-with-a-different-long-random-secret

DIRECTUS_URL=https://cms.example.com
DIRECTUS_TOKEN=replace-with-a-least-privilege-automation-service-token
SITE_URL=https://blog.example.com
DRAFT_PREVIEW_SECRET=replace-with-the-existing-preview-secret

CODEX_VERSION=0.144.6
CODEX_LIVE_SEARCH=false
CODEX_QUALITY_REVIEW_ENABLED=false
# Blank model roles use the currently signed-in Codex account's supported default model.
# Pin a role only to a model that appears in that account's Codex model picker.
CODEX_DRAFT_MODEL=
CODEX_IDEA_MODEL=
CODEX_REVIEW_MODEL=
CODEX_REVISION_MODEL=
CODEX_LEARNING_MODEL=
CODEX_REASONING_EFFORT=medium
CODEX_IDEA_REASONING_EFFORT=xhigh
CODEX_REVIEW_REASONING_EFFORT=medium
CODEX_REVISION_REASONING_EFFORT=medium
CODEX_LEARNING_REASONING_EFFORT=medium
CODEX_TIMEOUT_MS=720000
CODEX_IDEA_TIMEOUT_MS=900000
CODEX_REVIEW_TIMEOUT_MS=120000
CODEX_REVISION_TIMEOUT_MS=360000
CODEX_LEARNING_TIMEOUT_MS=120000
WORKER_MAX_ATTEMPTS=2
WORKER_WORKSPACE_RETENTION_DAYS=14
WORKER_JOB_RETENTION_DAYS=90
WORKER_PUBLISHED_RETENTION_DAYS=365
WORKER_BACKUP_MAX_AGE_HOURS=36
WORKER_FAILURE_ALERT_THRESHOLD=3
WORKER_LEARNING_FAILURE_ALERT_THRESHOLD=2
WORKER_ALERT_DEDUPE_HOURS=6

# Host-level Restic backup and maintenance coordination. Keep the project ID
# stable across a disaster-recovery move. BACKUP_DIR and both maintenance paths
# must be absolute paths outside the repository.
BACKUP_PROJECT_ID=content-ops
BACKUP_DIR=/var/backups/content-ops
MAINTENANCE_LOCK_DIR=/var/backups/content-ops/.maintenance.lock
MAINTENANCE_MARKER_FILE=/var/backups/content-ops/maintenance.state

{
	"name": "directus-blog-starter",
	"version": "1.0.0",
	"license": "MIT",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"check:public-bundle": "tsx scripts/check-public-bundle.ts",
		"content-ops:test": "npm --prefix automation/worker test",
		"content-ops:audit": "npm --prefix automation/worker audit --omit=dev --audit-level=moderate",
		"start": "next start",
		"test": "tsx --conditions=react-server --test tests/*.test.ts",
		"generate:types": "tsx ./src/lib/directus/generateDirectusTypes.ts",
		"directus:setup": "tsx ./scripts/directus-schema.ts",
		"directus:setup:apply": "tsx ./scripts/directus-schema.ts --apply",
		"directus:schema:pull": "tsx ./scripts/directus-schema.ts --pull",
		"lint": "next lint",
		"lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
		"format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\""
	},
	"dependencies": {
		"@directus/sdk": "20.0.3",
		"@directus/visual-editing": "2.0.0",
		"@hookform/resolvers": "5.0.1",
		"@radix-ui/react-checkbox": "1.1.4",
		"@radix-ui/react-dialog": "1.1.6",
		"@radix-ui/react-dropdown-menu": "2.1.6",
		"@radix-ui/react-label": "2.1.2",
		"@radix-ui/react-navigation-menu": "1.2.5",
		"@radix-ui/react-radio-group": "1.2.3",
		"@radix-ui/react-select": "2.1.6",
		"@radix-ui/react-separator": "1.1.2",
		"@radix-ui/react-slot": "1.1.2",
		"@radix-ui/react-tooltip": "1.1.8",
		"@tailwindcss/typography": "0.5.16",
		"@types/react": "19.1.0",
		"@types/react-dom": "19.1.1",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"dotenv": "16.4.7",
		"html-react-parser": "6.1.5",
		"lucide-react": "0.487.0",
		"next": "15.5.21",
		"p-queue": "8.1.0",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"react-hook-form": "7.55.0",
		"sanitize-html": "2.17.7",
		"server-only": "0.0.1",
		"shadcn": "2.4.0",
		"tailwind-merge": "3.6.0",
		"zod": "3.24.2"
	},
	"devDependencies": {
		"@eslint/js": "9.24.0",
		"@next/bundle-analyzer": "15.5.21",
		"@next/eslint-plugin-next": "15.5.21",
		"@types/node": "24.13.3",
		"@types/readline-sync": "1.4.8",
		"@types/sanitize-html": "2.16.0",
		"directus-sdk-typegen": "0.2.0",
		"eslint": "9.24.0",
		"eslint-config-next": "15.5.21",
		"eslint-config-prettier": "10.1.1",
		"eslint-plugin-import": "2.31.0",
		"eslint-plugin-promise": "7.2.1",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-tailwindcss": "3.18.0",
		"globals": "16.0.0",
		"postcss": "8.5.26",
		"prettier": "3.5.3",
		"prettier-plugin-tailwindcss": "0.6.11",
		"readline-sync": "1.4.10",
		"tailwindcss": "3.4.17",
		"tailwindcss-animate": "1.0.7",
		"tsx": "4.19.3",
		"typescript": "5.8.3",
		"typescript-eslint": "8.29.1"
	},
	"overrides": {
		"brace-expansion": "2.1.4",
		"eslint-import-resolver-typescript": "^4.4.5",
		"js-yaml": "4.3.1",
		"nanoid": "3.3.18",
		"postcss": "8.5.26",
		"semver": "^7.8.5",
		"sharp": "0.35.3",
		"undici-types": "8.8.0",
		"tar": "^7.5.4"
	}
}

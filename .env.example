NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055 # Or your cloud instance URL
DIRECTUS_SERVER_TOKEN=token_from_Webmaster_account
DRAFT_PREVIEW_SECRET=replace_with_a_long_random_preview_secret
DIRECTUS_ADMIN_TOKEN=token_from_Admin_account # Only for local type generation, never used at runtime
NEXT_PUBLIC_SITE_URL=http://localhost:3000    # Application URL
ENABLE_PUBLIC_WRITE=false                     # Opt in to the authenticated /write editor
WRITE_ACCESS_USERNAME=writer                  # Optional; defaults to writer
WRITE_ACCESS_PASSWORD=replace_with_at_least_16_random_characters
# Opt in only when authenticated /preview routes are used
NEXT_PUBLIC_ENABLE_VISUAL_EDITING=false
# Add these only after completing your analytics-consent and privacy review.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
